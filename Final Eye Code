from flask import Flask, render_template, request, jsonify
import RPi.GPIO as GPIO
import time
import threading
import smbus
from datetime import datetime, timedelta

app = Flask(__name__, template_folder='templates_2', static_folder='static_2')

# Servo setup
SERVO_PINS = [17, 27, 22]  # Adjust as needed
GPIO.setmode(GPIO.BCM)
GPIO.setwarnings(False)
for pin in SERVO_PINS:
    GPIO.setup(pin, GPIO.OUT)

servos = [GPIO.PWM(pin, 50) for pin in SERVO_PINS]
for s in servos:
    s.start(0)

# Sensor setup
I2C_ADDR = 0x23
bus = smbus.SMBus(1)

PIR_PIN = 23
GPIO.setup(PIR_PIN, GPIO.IN)
motion_detected = False
motion_reset_time = None

# System flags
autonomous_event = threading.Event()
dance_enabled = False

# Servo helpers
def set_servo(index, angle):
    duty = 2.5 + (angle / 180.0) * 10
    servos[index].ChangeDutyCycle(duty)

def center_servos():
    for i in range(3):
        set_servo(i, 67.5)

center_servos()

# Light sensor
def read_light():
    try:
        data = bus.read_i2c_block_data(I2C_ADDR, 0x10)  # Continuous H-Res mode
        result = (data[1] + (256 * data[0])) / 1.2
        return round(result, 2)
    except Exception as e:
        print(f"[ERROR] Light sensor read failed: {e}")
        return -1

def init_light_sensor():
    try:
        bus.write_byte(I2C_ADDR, 0x01)  # Power on
        time.sleep(0.05)
        bus.write_byte(I2C_ADDR, 0x10)  # Continuous H-Res mode
        print("[INIT] Light sensor initialized")
    except Exception as e:
        print(f"[ERROR] Failed to init light sensor: {e}")

# Autonomous behavior
def autonomous_loop():
    global motion_detected, motion_reset_time
    while True:
        if autonomous_event.is_set():
            light = read_light()
            print(f"[AUTO] Light level: {light}")
            set_servo(2, 135 if light > 50 else 0)  # Bright = open, Dark = closed

            if GPIO.input(PIR_PIN):
                motion_detected = True
                motion_reset_time = datetime.now() + timedelta(seconds=2)
                set_servo(0, 67.5)
                set_servo(1, 67.5)
            elif motion_reset_time and datetime.now() > motion_reset_time:
                motion_detected = False
                set_servo(0, 0)
                set_servo(1, 135)
        time.sleep(0.1)

# Dance behavior
def dance_loop():
    while True:
        if dance_enabled:
            for _ in range(2):
                for angle in range(0, 136, 10):
                    set_servo(0, angle)
                    set_servo(1, angle)
                    time.sleep(0.05)
                for angle in range(135, -1, -10):
                    set_servo(0, angle)
                    set_servo(1, angle)
                    time.sleep(0.05)
            for _ in range(2):
                for angle in range(0, 136, 10):
                    set_servo(0, angle)
                    set_servo(1, 135 - angle)
                    time.sleep(0.05)
                for angle in range(135, -1, -10):
                    set_servo(0, angle)
                    set_servo(1, 135 - angle)
                    time.sleep(0.05)
        time.sleep(6)

@app.route('/')
def index_3():
    return render_template('index_3.html')

@app.route('/control', methods=['POST'])
def control():
    if not autonomous_event.is_set() and not dance_enabled:
        data = request.get_json()
        x, y = data['x'], data['y']
        set_servo(0, x)
        set_servo(1, x)
        set_servo(2, y)
    return ('', 204)

@app.route('/reset', methods=['POST'])
def reset():
    center_servos()
    return ('', 204)

@app.route('/autonomous', methods=['POST'])
def toggle_autonomous():
    global dance_enabled
    data = request.get_json()
    if data['enabled']:
        autonomous_event.set()
        dance_enabled = False
    else:
        autonomous_event.clear()
    return ('', 204)

@app.route('/dance', methods=['POST'])
def toggle_dance():
    global dance_enabled
    data = request.get_json()
    dance_enabled = data['enabled']
    if dance_enabled:
        autonomous_event.clear()
    return ('', 204)

@app.route('/status')
def status():
    return jsonify({
        'light_level': read_light(),
        'motion_detected': motion_detected
    })

if __name__ == '__main__':
    init_light_sensor()
    threading.Thread(target=autonomous_loop, daemon=True).start()
    threading.Thread(target=dance_loop, daemon=True).start()
    app.run(host='0.0.0.0', port=5000)

